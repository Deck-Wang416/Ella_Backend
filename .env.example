# App
APP_NAME=ELLA Reminder Backend
ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Database (SQLite for MVP; can switch to PostgreSQL URL later)
DATABASE_URL=sqlite:///./ella.db

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Internal API key for protected internal endpoints (optional but recommended)
INTERNAL_API_KEY=change_me

# Notification delivery
NOTIFICATION_MAX_RETRIES=2

# Web Push (Phase2)
WEB_PUSH_DRY_RUN=true
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_CLAIMS_SUB=mailto:admin@example.com

# Mobile Push prototype (Phase2)
MOBILE_PUSH_DRY_RUN=true

# CORS / host checks for local+tunnel testing
CORS_ALLOW_ALL=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trusted hosts (comma-separated, use * for local testing)
TRUSTED_HOSTS=*
